OPENAI_API_KEY=your_api_key_here
OPENAI_API_BASE=https://api.edgefn.net/v1
CHAT_MODEL=GLM-5
CHAT_TEMPERATURE=0.5
CHAT_THREAD_ID=global_user_session_v3
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# 可选：设置后可减少 HuggingFace 未认证请求的警告并提高下载限速
# HF_TOKEN=your_huggingface_token
KNOWLEDGE_TOP_K=3
ENABLE_PYTHON_REPL=0

# 开发助手与安全（全功能 Agent）
# 工作区根目录，留空则使用项目根；开发工具只能访问此目录及子目录
AGENT_WORKSPACE_ROOT=
# 写文件/创建/修改前是否要求人工确认（1=是，0=否）
REQUIRE_CONFIRM_ON_WRITE=1
# 执行终端命令前是否要求人工确认（1=是，0=否）
REQUIRE_CONFIRM_ON_COMMAND=1
# 是否允许使用 delete_path 删除文件或目录（0=禁止，1=允许且需确认）
ALLOW_DELETE_PATH=0
# execute_command 单次命令最长执行秒数
COMMAND_TIMEOUT_SECONDS=30
